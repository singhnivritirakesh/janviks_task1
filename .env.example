# ==============================================================================
# PlaySphere Connect - Environment Configuration Template
# ==============================================================================
# WARNING: NEVER commit actual secrets, keys, or passwords to version control.
# Copy this file to .env and configure local values before running the application.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://playsphere_app:YourSecurePasswordHere@localhost:5432/playsphere_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=playsphere_db
DB_USER=playsphere_app
DB_PASSWORD=ChangeThisToAStrongSecretPassword

# Cryptographic Keys (RS256 JWT Authentication)
# Private key is loaded from server/keys/jwt_private.pem or from base64/env
JWT_PRIVATE_KEY_PATH=server/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=server/keys/jwt_public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=playsphere-auth-service
JWT_AUDIENCE=playsphere-client

# Cookie Security & CSRF
COOKIE_SECRET=ChangeThisToARandom32ByteSecretStringForCookieSignatures
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS Allow-list (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://localhost

# Rate Limiting & Account Lockout
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Security Alerts Thresholds
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_FAILED_LOGIN_WINDOW_MINUTES=10
ALERT_UNAUTHORIZED_THRESHOLD=5
ALERT_UNAUTHORIZED_WINDOW_MINUTES=5
ALERT_DATA_EXPORT_THRESHOLD=1000

# Frontend Configuration
VITE_API_BASE_URL=/api
